# Force LF for files that run inside the Linux container or are parsed by it.
# Without this, a Windows checkout (core.autocrlf=true) yields CRLF scripts that
# break `#!/bin/bash` and are then COPYed into the image by `docker build`.
*.sh        text eol=lf
*.json      text eol=lf
*.yml       text eol=lf
*.yaml      text eol=lf
*.ini       text eol=lf
Dockerfile* text eol=lf
.env.example text eol=lf
